*.pkl
*.joblib
*.h5

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Testing / coverage ---
.pytest_cache/
.coverage
htmlcov/

# --- Data (avoid committing large/generated datasets by accident) ---
*.csv
*.sqlite3