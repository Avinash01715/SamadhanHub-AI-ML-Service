venv/
.venv/
env/
ENV/
.python-version

# --- Packaging / build artifacts ---
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# --- Environment / secrets ---
.env
.env.*
*.pem
*.key

# --- FastAPI / uvicorn ---
*.log

# --- Streamlit ---
.streamlit/secrets.toml

# --- Jupyter (in case notebooks get added later) ---
.ipynb_checkpoints/

